---
interface Props {
  categories: { id: string; label: string; count: number }[];
}

const { categories } = Astro.props;
---

<div class="flex items-center gap-2 py-4 overflow-x-auto no-scrollbar" data-category-filter>
  {categories.map((category, index) => (
    <a
      href={`#${category.id}`}
      data-category-pill={category.id}
      class:list={[
        "category-pill whitespace-nowrap px-5 py-2.5 text-sm font-medium transition-colors duration-300 flex items-center gap-2",
        index === 0 && "active",
      ]}
    >
      {category.label}
      <span class="text-xs opacity-70">({category.count})</span>
    </a>
  ))}
</div>

<style>
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }

  .category-pill {
    border: 1px solid transparent;
    color: #50453b;
    border-radius: 0.75rem;
  }

  .category-pill:hover {
    background: rgba(130, 117, 106, 0.1);
    border-color: #82756a;
    color: #1e1b13;
  }

  .category-pill.active {
    background: #ff6666;
    color: white;
    border-color: #ff6666;
  }

  .category-pill.active span {
    color: rgba(255, 255, 255, 0.85);
  }
</style>

<script>
  const root = document.querySelector('[data-category-filter]');
  if (root) {
    const pills = Array.from(root.querySelectorAll('[data-category-pill]'));
    const sections = pills
      .map((p) => document.getElementById(p.dataset.categoryPill))
      .filter(Boolean);

    let lockUntil = 0;

    const setActive = (id) => {
      pills.forEach((pill) => {
        pill.classList.toggle('active', pill.dataset.categoryPill === id);
      });
      const activePill = pills.find((p) => p.dataset.categoryPill === id);
      if (activePill) {
        activePill.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
      }
    };

    pills.forEach((pill) => {
      pill.addEventListener('click', (e) => {
        const id = pill.dataset.categoryPill;
        const target = id ? document.getElementById(id) : null;
        if (!id || !target) return;
        e.preventDefault();
        lockUntil = performance.now() + 800;
        setActive(id);
        const header = document.querySelector('header');
        const headerH = header ? header.getBoundingClientRect().height : 0;
        const filterH = root.getBoundingClientRect().height;
        const top = target.getBoundingClientRect().top + window.scrollY - headerH - filterH - 8;
        window.scrollTo({ top, behavior: 'smooth' });
        history.replaceState(null, '', `#${id}`);
      });
    });

    const observer = new IntersectionObserver(
      (entries) => {
        if (performance.now() < lockUntil) return;
        const visible = entries
          .filter((e) => e.isIntersecting)
          .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
        if (visible) setActive(visible.target.id);
      },
      { rootMargin: '-35% 0px -55% 0px', threshold: [0, 0.25, 0.5, 0.75, 1] }
    );
    sections.forEach((s) => observer.observe(s));
  }
</script>
