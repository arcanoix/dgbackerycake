---
interface Props {
	title?: string;
	description?: string;
	image?: string;
	type?: string;
}

const {
	title = 'DGBACKERY&CAKE - Repostería Artesanal y Pan Fresco',
	description = 'Tortas personalizadas, pan artesanal y repostería de calidad. Hacemos realidad tus momentos especiales con sabor y dedicación.',
	image = '/og-image.jpg',
	type = 'website'
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="theme-color" content="#fff8ef" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="keywords" content="repostería, tortas, pan artesanal, pasteles, postres, pedidos personalizados, cumpleaños, eventos, DGBACKERY, repostería casera" />
		<link rel="canonical" href={canonicalURL} />
		
		<!-- Open Graph / Facebook -->
		<meta property="og:type" content={type} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={new URL(image, Astro.site)} />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content="DGBACKERY&CAKE" />
		
		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:url" content={canonicalURL} />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={new URL(image, Astro.site)} />
		
		<!-- Preconnect to external domains -->
		<link rel="preconnect" href="https://www.googletagmanager.com" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		
		<!-- Google Fonts - L'Artisan Crème Design System -->
		<link href="https://fonts.googleapis.com/css2?family=Noto+Serif:wght@400;500;600;700&family=Manrope:wght@300;400;500;600;700&family=Dancing+Script:wght@400;500;600;700&display=swap" rel="stylesheet" />
		
		<!-- Per-page head injections (Schema markup, etc.) -->
		<slot name="head" />
		
		<!-- Google tag (gtag.js) -->
		<script type="text/partytown" async src="https://www.googletagmanager.com/gtag/js?id=G-4HDKR04H89"></script>
		<script type="text/partytown">
			window.dataLayer = window.dataLayer || [];
			function gtag(){dataLayer.push(arguments);}
			gtag('js', new Date());
			gtag('config', 'G-4HDKR04H89');
		</script>
	</head>
	<body>
		<a href="#main-content" class="skip-link">Saltar al contenido principal</a>
		<div id="main-content">
			<slot />
		</div>
		
		<!-- Scroll-triggered animations -->
		<script>
			if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
				const observer = new IntersectionObserver((entries) => {
					entries.forEach((entry) => {
						if (entry.isIntersecting) {
							entry.target.classList.add('is-visible');
							observer.unobserve(entry.target);
						}
					});
				}, { threshold: 0.1, rootMargin: '0px 0px -50px 0px' });
				
				document.querySelectorAll('.animate-on-scroll').forEach((el) => observer.observe(el));
			} else {
				document.querySelectorAll('.animate-on-scroll').forEach((el) => el.classList.add('is-visible'));
			}
		</script>
		
		<!-- Service Worker registration -->
		<script>
			if ('serviceWorker' in navigator) {
				window.addEventListener('load', () => {
					navigator.serviceWorker.register('/sw.js').catch(() => {});
				});
			}
		</script>
	</body>
</html>

<style is:global>
	@tailwind base;
	@tailwind components;
	@tailwind utilities;
	
	@layer base {
		:root {
			/* L'Artisan Crème Design System - Colors */
			--color-surface: #fff8ef;
			--color-surface-bright: #fff8ef;
			--color-surface-container: #f5edde;
			--color-surface-container-low: #fbf3e4;
			--color-surface-container-high: #efe7d9;
			--color-surface-container-highest: #e9e2d3;
			--color-surface-container-lowest: #ffffff;
			
			--color-primary: #ff6666;
			--color-primary-container: #ffc8c5;
			--color-on-primary: #ffffff;
			--color-on-primary-container: #cc4444;
			
			--color-secondary: #ffcc99;
			--color-secondary-container: #ffe8db;
			--color-on-secondary: #1e1b13;
			--color-on-secondary-container: #8c5e3c;
			
			--color-tertiary: #d9774a;
			--color-tertiary-container: #ffdfcc;
			--color-on-tertiary: #ffffff;
			
			--color-outline: #a18f7e;
			--color-outline-variant: #e8ddd4;
			
			--color-on-surface: #1e1b13;
			--color-on-surface-variant: #6b5d4f;
			
			/* Brand Colors */
			--color-brand-peach: #ffcc99;
			--color-brand-coral: #ff6666;
			--color-brand-cream: #fff8ef;
		}
		
		*,
		*::before,
		*::after {
			box-sizing: border-box;
		}
		
		html {
			scroll-behavior: smooth;
		}
		
		html,
		body {
			@apply m-0 p-0 w-full min-h-full;
			font-family: 'Manrope', system-ui, sans-serif;
			color: var(--color-on-surface);
			background-color: var(--color-surface);
			-webkit-font-smoothing: antialiased;
			-moz-osx-font-smoothing: grayscale;
			line-height: 1.6;
		}
		
		/* Editorial Typography */
		h1, h2, h3, h4, h5, h6 {
			font-family: 'Noto Serif', serif;
			font-weight: 600;
			margin: 0;
			line-height: 1.2;
			color: var(--color-on-surface);
		}
		
		h1 {
			font-size: clamp(2.5rem, 5vw, 4rem);
			letter-spacing: -0.02em;
		}
		
		h2 {
			font-size: clamp(2rem, 4vw, 3rem);
			letter-spacing: -0.01em;
		}
		
		h3 {
			font-size: clamp(1.5rem, 3vw, 2rem);
		}
		
		p {
			margin: 0;
			color: var(--color-on-surface-variant);
		}
		
		a {
			color: inherit;
			text-decoration: none;
			transition: color 0.3s ease, background-color 0.3s ease, border-color 0.3s ease, transform 0.3s ease, box-shadow 0.3s ease;
		}
		
		img {
			max-width: 100%;
			height: auto;
			display: block;
		}
		
		button {
			font-family: 'Manrope', system-ui, sans-serif;
			cursor: pointer;
			border: none;
			background: none;
		}
	}
	
	@layer components {
		/* Editorial Button Styles */
		.btn-primary {
			@apply inline-flex items-center justify-center px-8 py-4;
			background: linear-gradient(135deg, var(--color-brand-coral), #e55555);
			color: white;
			font-weight: 600;
			font-size: 0.95rem;
			letter-spacing: 0.025em;
			border-radius: 0.75rem;
			transition: transform 0.3s ease, box-shadow 0.3s ease, background 0.3s ease;
			box-shadow: 0 4px 20px rgba(255, 102, 102, 0.2);
		}
		
		.btn-primary:hover {
			transform: translateY(-2px);
			box-shadow: 0 8px 30px rgba(255, 102, 102, 0.3);
		}
		
		.btn-secondary {
			@apply inline-flex items-center justify-center px-8 py-4;
			background: transparent;
			color: var(--color-on-surface);
			font-weight: 600;
			font-size: 0.95rem;
			letter-spacing: 0.025em;
			border: 1px solid var(--color-outline-variant);
			border-radius: 0.75rem;
			transition: background-color 0.3s ease, border-color 0.3s ease, transform 0.3s ease, box-shadow 0.3s ease;
		}
		
		.btn-secondary:hover {
			background: var(--color-surface-container);
			border-color: var(--color-primary);
		}
		
		/* Category Label Style */
		.category-label {
			font-family: 'Manrope', sans-serif;
			font-size: 0.75rem;
			font-weight: 600;
			letter-spacing: 0.15em;
			text-transform: uppercase;
			color: var(--color-primary);
		}
		
		/* Section Container */
		.section-container {
			@apply w-full;
			padding-top: clamp(4rem, 8vw, 7rem);
			padding-bottom: clamp(4rem, 8vw, 7rem);
		}
		
		/* Card Shadow - Soft & Ambient */
		.card-shadow {
			box-shadow: 0 20px 80px rgba(80, 69, 59, 0.08);
		}
		
		.card-shadow-hover {
			box-shadow: 0 30px 100px rgba(80, 69, 59, 0.12);
		}
		
		/* Ghost Border */
		.ghost-border {
			border: 1px solid rgba(130, 117, 106, 0.15);
		}
		
		/* Glass Effect for Navigation */
		.glass-effect {
			background: rgba(255, 248, 239, 0.85);
			backdrop-filter: blur(12px);
			-webkit-backdrop-filter: blur(12px);
		}
	}
	
	@layer utilities {
		/* Editorial Spacing Scale */
		.editorial-spacing {
			padding-top: clamp(4rem, 8vw, 7rem);
			padding-bottom: clamp(4rem, 8vw, 7rem);
		}
		
		.text-balance {
			text-wrap: balance;
		}
		
		/* Script/Display Font for Romantic Accents */
		.font-script {
			font-family: 'Dancing Script', 'Noto Serif', cursive;
		}
	}
	
		/* Respect user's motion preferences */
		@media (prefers-reduced-motion: reduce) {
			*,
			*::before,
			*::after {
				animation-duration: 0.01ms !important;
				animation-iteration-count: 1 !important;
				transition-duration: 0.01ms !important;
				scroll-behavior: auto !important;
			}
		}
		
		/* Scroll margin for anchored headings */
		h1, h2, h3, h4, h5, h6 {
			scroll-margin-top: 6rem;
		}
	
		/* Scroll-triggered animation classes */
		.animate-on-scroll {
			opacity: 0;
			transform: translateY(24px);
			transition: opacity 0.6s ease-out, transform 0.6s ease-out;
		}
		
		.animate-on-scroll.is-visible {
			opacity: 1;
			transform: translateY(0);
		}
		
		.animate-fade {
			opacity: 0;
			transition: opacity 0.8s ease-out;
		}
		
		.animate-fade.is-visible {
			opacity: 1;
		}
		
		/* Stagger children animations */
		.stagger-children > .animate-on-scroll:nth-child(1) { transition-delay: 0ms; }
		.stagger-children > .animate-on-scroll:nth-child(2) { transition-delay: 100ms; }
		.stagger-children > .animate-on-scroll:nth-child(3) { transition-delay: 200ms; }
		.stagger-children > .animate-on-scroll:nth-child(4) { transition-delay: 300ms; }
		.stagger-children > .animate-on-scroll:nth-child(5) { transition-delay: 400ms; }
		.stagger-children > .animate-on-scroll:nth-child(6) { transition-delay: 500ms; }
		
		/* Skip-to-content link for accessibility */
	.skip-link {
		position: absolute;
		top: -100%;
		left: 50%;
		transform: translateX(-50%);
		z-index: 9999;
		background: var(--color-primary);
		color: white;
		padding: 0.75rem 1.5rem;
		font-weight: 600;
		border-radius: 0 0 0.75rem 0.75rem;
		box-shadow: 0 4px 20px rgba(0,0,0,0.2);
		transition: top 0.3s ease;
		text-decoration: none;
	}
	
	.skip-link:focus {
		top: 0;
	}
</style>
